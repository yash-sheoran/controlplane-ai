DB_NAME=controlplane_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Section 3 Step 9 MODIFY: "Logs the original content (encrypted) ... to
# the audit log for compliance review." Generate your own key for any
# real deployment:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODIFICATION_LOG_ENCRYPTION_KEY=REPLACE_WITH_YOUR_OWN_FERNET_KEY

# Set DJANGO_DEBUG=True for local development only. Leave it unset (or
# False) in any deployment: DEBUG=False is the default so a missing value
# can never expose tracebacks publicly.
DJANGO_DEBUG=True

# Generate a unique key per deployment; never reuse this placeholder:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-key

# Comma-separated extra hostnames. On Railway this is optional: the app
# reads RAILWAY_PUBLIC_DOMAIN automatically.
DJANGO_ALLOWED_HOSTS=
